datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Tipos de datos restringidos)
// ==========================================

enum Rol {
  ADMIN
  DIRECTIVO
  DOCENTE
  PRECEPTOR
  EOE
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoEstudiante {
  REGULAR
  RETIRADO
  EGRESADO
  SUSPENDIDO
}

enum TipoTurno {
  MANANA
  TARDE
  VESPERTINO
}

enum TipoCursada {
  C // Cursa
  R // Recursa
}

enum ValoracionPreliminar {
  TEA
  TEP
  TED
}

enum CodigoResultadoIntensificacion {
  AA
  CCA
  CSA
}

enum EstadoRITE {
  BORRADOR
  CERRADO
  FIRMADO
}

enum TipoEventoIntervencion {
  PEDAGOGICO
  SALUD
  CONDUCTA
}

// ==========================================
// MODELOS / TABLAS
// ==========================================

model Usuario {
  id           String        @id @default(uuid())
  nombre       String
  email        String        @unique
  passwordHash String        @map("password_hash")
  rol          Rol           @default(DOCENTE)
  estado       EstadoUsuario @default(ACTIVO)

  // Relaciones inversas
  intervenciones Intervencion[]
  conflictos     ConflictoLegal[]
  logs           LogAuditoria[]

  @@map("usuarios")
}

model Estudiante {
  id              String           @id @default(uuid())
  dni             String           @unique
  apellido        String
  nombre          String
  fechaNacimiento DateTime         @map("fecha_nacimiento") @db.Date
  domicilio       String?
  telefono        String?
  estado          EstadoEstudiante @default(REGULAR)
  legajo          String           @unique

  // Relaciones inversas
  inscripciones      Inscripcion[]
  asistenciasDiarias AsistenciaDiaria[]
  asistenciasMateria AsistenciaMateria[]
  rites              Rite[]
  intervenciones     Intervencion[]
  conflictosLegales  ConflictoLegal[]
  pates              Pate[]

  @@map("estudiantes")
}

model CursoSeccion {
  id          String    @id @default(uuid())
  anio        Int
  division    String
  turno       TipoTurno
  orientacion String?
  anioLectivo Int       @map("anio_lectivo")

  inscripciones Inscripcion[]

  @@map("cursos_secciones")
}

model Materia {
  id                  String @id @default(uuid())
  nombre              String
  codigo              String @unique
  cargaHoraria        Int    @map("carga_horaria")
  anioCorrespondiente Int    @map("anio_correspondiente")
  area                String

  inscripciones      Inscripcion[]
  asistenciasMateria AsistenciaMateria[]

  @@map("materias")
}

model Inscripcion {
  id             String      @id @default(uuid())
  estudianteId   String      @map("estudiante_id")
  cursoSeccionId String      @map("curso_seccion_id")
  materiaId      String      @map("materia_id")
  tipoCursada    TipoCursada @default(C) @map("tipo_cursada")
  anioLectivo    Int         @map("anio_lectivo")
  estadoMateria  String      @map("estado_materia")

  // Relaciones (Claves Foráneas)
  estudiante   Estudiante   @relation(fields: [estudianteId], references: [id])
  cursoSeccion CursoSeccion @relation(fields: [cursoSeccionId], references: [id])
  materia      Materia      @relation(fields: [materiaId], references: [id])

  calificaciones    Calificacion[]
  intensificaciones Intensificacion[]

  @@map("inscripciones")
}

model AsistenciaDiaria {
  id           String    @id @default(uuid())
  estudianteId String    @map("estudiante_id")
  fecha        DateTime  @db.Date
  valorFalta   Float     @map("valor_falta") // 1.0, 0.5, 0.25
  turno        TipoTurno
  justificada  Boolean   @default(false)
  observacion  String?

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@map("asistencias_diarias")
}

model AsistenciaMateria {
  id           String   @id @default(uuid())
  estudianteId String   @map("estudiante_id")
  materiaId    String   @map("materia_id")
  fechaClase   DateTime @map("fecha_clase") @db.Date
  presente     Boolean  @default(true)
  justificada  Boolean  @default(false)

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  materia    Materia    @relation(fields: [materiaId], references: [id])

  @@map("asistencias_materias")
}

model Calificacion {
  id                      String                @id @default(uuid())
  inscripcionId           String                @map("inscripcion_id")
  cuatrimestre            Int                   // 1 o 2
  valoracionPreliminar    ValoracionPreliminar? @map("valoracion_preliminar")
  notaCuatrimestre        Float?                @map("nota_cuatrimestre")
  intensif1erCuatrimestre Boolean               @default(false) @map("intensif_1er_cuatrimestre")
  notaFinal               Float?                @map("nota_final")
  estadoMateria           String                @map("estado_materia")

  inscripcion Inscripcion @relation(fields: [inscripcionId], references: [id])

  @@map("calificaciones")
}

model Intensificacion {
  id                  String                          @id @default(uuid())
  inscripcionId       String                          @map("inscripcion_id")
  periodo             String                          // Dic / Feb-Mar / Ago
  modelo              Int                             // 1, 2, 3, 4
  codigoResultado     CodigoResultadoIntensificacion? @map("codigo_resultado")
  notaIntensificacion Float?                          @map("nota_intensificacion")
  saberesPendientes   String?                         @map("saberes_pendientes")
  urlEvidencia        String?                         @map("url_evidencia")

  inscripcion Inscripcion @relation(fields: [inscripcionId], references: [id])

  @@map("intensificaciones")
}

model Rite {
  id                     String     @id @default(uuid())
  estudianteId           String     @map("estudiante_id")
  anioLectivo            Int        @map("anio_lectivo")
  cuatrimestre           Int
  observacionesGenerales String?    @map("observaciones_generales")
  estado                 EstadoRITE @default(BORRADOR)
  fechaFirma             DateTime?  @map("fecha_firma")
  autoridadFirmante      String?    @map("autoridad_firmante")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@map("rites")
}

model Intervencion {
  id           String                 @id @default(uuid())
  estudianteId String                 @map("estudiante_id")
  autorId      String                 @map("autor_id")
  tipoEvento   TipoEventoIntervencion @map("tipo_evento")
  descripcion  String
  fecha        DateTime               @default(now())
  evidenciaUrl String?                @map("evidencia_url")
  firmaDigital String?                @map("firma_digital")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  autor      Usuario    @relation(fields: [autorId], references: [id])

  @@map("intervenciones")
}

model ConflictoLegal {
  id               String   @id @default(uuid())
  estudianteId     String   @map("estudiante_id")
  autorId          String   @map("autor_id")
  codigoConflicto  String   @map("codigo_conflicto")
  informeDetallado String   @map("informe_detallado")
  bloqueoEdicion   Boolean  @default(true) @map("bloqueo_edicion")
  hashFirmaDigital String   @map("hash_firma_digital")
  uuidDocumento    String   @unique @default(uuid()) @map("uuid_documento")
  fechaRegistro    DateTime @default(now()) @map("fecha_registro")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  autor      Usuario    @relation(fields: [autorId], references: [id])

  @@map("conflictos_legales")
}

model EdteReunion {
  id              String   @id @default(uuid())
  fecha           DateTime @db.Date
  periodo         String
  integrantes     String
  consideraciones String
  actaUrl         String?  @map("acta_url")

  pates Pate[]

  @@map("edte_reuniones")
}

model Pate {
  id                   String   @id @default(uuid())
  estudianteId         String   @map("estudiante_id")
  edteReunionId        String   @map("edte_reunion_id")
  materiasIntensificar String   @map("materias_intensificar")
  materiasRecursar     String   @map("materias_recursar")
  consideraciones      String?
  estado               String
  fechaCreacion        DateTime @default(now()) @map("fecha_creacion")

  estudiante  Estudiante  @relation(fields: [estudianteId], references: [id])
  edteReunion EdteReunion @relation(fields: [edteReunionId], references: [id])

  @@map("pates")
}

model LogAuditoria {
  id              String   @id @default(uuid())
  usuarioId       String   @map("usuario_id")
  fechaHora       DateTime @default(now()) @map("fecha_hora")
  accion          String
  entidadAfectada String   @map("entidad_afectada")
  datoAnterior    Json?    @map("dato_anterior")
  datoNuevo       Json?    @map("dato_nuevo")
  direccionIp     String?  @map("direccion_ip")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("logs_auditoria")
}