# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BASE_DATOS?schema=ESQUEMA"


JWT_SECRET=generar_una_clave_larga_y_aleatoria

# CRM-090: OBLIGATORIA - clave AES-256-GCM para informes y secretos TOTP.
# Generar una clave aleatoria de 32 bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Configurar el valor generado como secreto en cada entorno.
# No subir claves reales al repositorio.
# Conservar la clave: perderla impide descifrar los datos existentes.
# No cambiarla sin un procedimiento de rotación y recifrado.
CONFLICT_ENCRYPTION_KEY=
